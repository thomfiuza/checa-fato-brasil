# Checa Fato Brasil — MODELO de variáveis de PRODUÇÃO
# =====================================================================
# NUNCA preencha este arquivo e suba para o GitHub.
# Use apenas como referência. Os valores reais ficam:
#   - na Render: aba "Environment" do serviço (e do Postgres, se houver)
#   - na VPS:    arquivo /etc/checafato.env (permissão 600) + systemd
# =====================================================================

# --- Servidor ---
PORT=8080
HOST=0.0.0.0

# --- Painel de curadoria (OBRIGATÓRIO trocar em produção) ---
# Usuário do painel de curadoria
ADMIN_USER=editor
# Senha forte (mín. 12 caracteres, letras + números + símbolo). Ex.: Cfb!2026Minas
ADMIN_PASS=TROQUE_POR_SENHA_FORTE

# --- Segurança (OBRIGATÓRIO) ---
# Segredo para assinar tokens de sessão. Gere um texto aleatório longo, ex.:
#   openssl rand -hex 32
JWT_SECRET=TROQUE_POR_TEXTO_ALEATORIO_LONGO

# --- Persistência de dados (recomendado em produção) ---
# String de conexão do PostgreSQL (na Render: New -> PostgreSQL).
# Sem esta variável o app usa JSON local (data/checks.json), que NÃO
# persiste em reinícios do plano Free da Render.
# Ex.: postgresql://USER:PASS@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# --- Revalidação periódica (opcional) ---
# Intervalo em ms (900000 = 15 min)
REVALID_MS=900000

# --- Integração externa (opcional) ---
# Chave da API do Google Fact Check Tools (https://developers.google.com/fact-check-tools)
GCC_API_KEY=

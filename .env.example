# Checa Fato Brasil — variáveis de ambiente (opcional)
# Copie para .env e preencha. Nenhuma chave é obrigatória para rodar a demo.

# Porta do servidor
PORT=8080
# Interface de escuta
HOST=0.0.0.0

# Chave da API do Google Fact Check Tools (ClaimReview search).
# Sem ela, o motor usa apenas análise local + heurísticas de linguagem.
# Obtenha em: https://developers.google.com/fact-check-tools
GCC_API_KEY=

# Acesso ao painel de curadoria (obrigatório trocar em produção)
ADMIN_USER=editor
ADMIN_PASS=checafato
